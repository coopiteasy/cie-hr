<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit</field>
        <field name="model">res.config.settings</field>
        <field
            name="inherit_id"
            ref="hr_work_entry_contract_attendance_oca.res_config_settings_view_form"
        />
        <field name="arch" type="xml">
            <xpath
                expr="//setting[@id='attendance_hr_work_entry_type']"
                position="after"
            >
                <setting
                    company_dependent="1"
                    string="Absence Work Entry Type"
                    id="absence_hr_work_entry_type"
                    help="Work entry type to use for work entries corresponding to an absence."
                >
                    <field name="absence_hr_work_entry_type_id" required="1" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
